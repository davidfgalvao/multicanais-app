# Playlist primária iptv-org (predefinido: countries/br.m3u)
# IPTV_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u

# Listas extra do repositório github.com/iprtl/m3u (ramo live por defeito)
# Desativar: SKIP_IPRTL_M3U=1 ou IPRTL_M3U=0
# Outro ramo/commit: IPRTL_M3U_REF=main

# Manter canais com bandeira estrangeira ou palavras de outros países no grupo/nome (predefinido: remove)
# KEEP_FOREIGN_FLAG_CHANNELS=1

# Saltar download no build
# SKIP_IPTV_FETCH=1

# Não descarregar logos.json / channels.json do iptv-org (build/import mais rápido, logos só do M3U)
# SKIP_LOGO_ENRICH=1

# Lista local manual: npm run import:channels (ver /guia)

# URL pública (opcional): melhora Open Graph / partilhas sociais com a logo
# NEXT_PUBLIC_SITE_URL=https://teu-dominio.vercel.app

# —— Vercel (deploy) ——
# 1) Liga o repositório em https://vercel.com → Add New Project → importa este repo.
# 2) Framework: Next.js (detetado); Build: npm run build; Output: .next (automático).
# 3) Em Settings → Environment Variables (Production): define NEXT_PUBLIC_SITE_URL com o URL
#    final do projeto, ex.: https://multicanais-app.vercel.app — assim metadados/OG usam o domínio certo.
# 4) Depois do primeiro deploy, copia o mesmo URL para CAPACITOR_SERVER_URL no ambiente local
#    quando fores sincronizar o Capacitor, ou define CAPACITOR_SERVER_URL também na Vercel só se
#    precisares de o valor em build (o capacitor.config usa env no sync local).

# —— Capacitor (app multiplataforma) ——
# URL do Next.js que o WebView abre (produção ou o teu deploy)
# CAPACITOR_SERVER_URL=https://multicanais-app.vercel.app
# Dev na LAN: `next dev --hostname 0.0.0.0` e usa o IP da máquina
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000

# —— PWA (Safari iOS — Adicionar ao ecrã principal) ——
# O service worker e o manifest ativos vêm do `next build` + `next start` ou deploy HTTPS.
# Em http://IP:3000 na rede local, o Safari pode não registar o SW; usa Vercel/ngrok ou localhost com túnel.
