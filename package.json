{
  "name": "multicanais-esporte",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "fetch:iptv": "tsx scripts/fetch-iptv-org.ts",
    "pwa:icons": "tsx scripts/generate-pwa-icons.ts",
    "prebuild": "npm run pwa:icons",
    "build": "npm run fetch:iptv && next build",
    "build:skip-fetch": "npm run pwa:icons && SKIP_IPTV_FETCH=1 next build",
    "start": "next start",
    "lint": "next lint",
    "import:channels": "tsx scripts/import-m3u.ts",
    "import:paste": "pbpaste | tsx scripts/import-m3u.ts -",
    "cap:sync": "npx cap sync",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@serwist/next": "^9.5.11",
    "hls.js": "^1.6.15",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serwist": "^9.5.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
